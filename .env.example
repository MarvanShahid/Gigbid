# Copy to .env and fill in. Never commit .env.
# --- models (open profile = Groq hosted open-weight models) ---
GIGBID_PROFILE=open
GROQ_API_KEY=
PAID_API_KEY=
PAID_BASE_URL=
PAID_WRITER_MODEL=
OLLAMA_URL=http://localhost:11434/v1
# --- secrets (generate long random values for production) ---
SESSION_SECRET=
APPROVAL_SECRET=
TOKEN_ENC_KEY=            # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MCP_TOKENS=gigbid:change-me-internal-token
MCP_CLIENT_TOKEN=change-me-internal-token
POSTGRES_PASSWORD=
# --- reviewer login seeded at startup (preloaded with the ml_engineer persona) ---
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=
# --- marketplace ---
GIGSIM_URL=http://localhost:8100
SIM_ADMIN_KEY=
UPWORK_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback
# --- infra (filled by docker compose; set by hand for local runs) ---
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
MCP_MODE=inmemory
VECTOR_BACKEND=auto
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_UI_URL=
CORS_ORIGINS=http://localhost:3000
